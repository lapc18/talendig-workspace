{
  "meta": {
    "name": "Talendig Design System (Tailwind + Lexend/Noto Match)",
    "version": "1.2.0",
    "description": "Design tokens aligned with the provided HTML/Tailwind config: primary #1337ec, background-light #f6f6f8, background-dark #101322, Lexend + Noto Sans, compact radii and dual light/dark surfaces.",
    "grid": { "baseUnitPx": 8 }
  },

  "fonts": {
    "google": [
      "Lexend:wght@300;400;500;600;700",
      "Noto Sans:wght@400;500;700",
      "Material Symbols Outlined:wght@100..700"
    ],
    "family": {
      "display": "Lexend, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial",
      "body": "Noto Sans, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace"
    }
  },

  "tailwind": {
    "darkMode": "class",
    "extend": {
      "colors": {
        "primary": "#1337ec",
        "background-light": "#f6f6f8",
        "background-dark": "#101322"
      },
      "fontFamily": {
        "display": ["Lexend", "sans-serif"],
        "body": ["Noto Sans", "sans-serif"]
      },
      "borderRadius": {
        "DEFAULT": "0.25rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "full": "9999px"
      }
    }
  },

  "theme": {
    "modeDefault": "light",
    "modes": ["light", "dark"],
    "breakpointsPx": { "xs": 0, "sm": 600, "md": 900, "lg": 1200, "xl": 1536 }
  },

  "colors": {
    "core": {
      "primary": "#1337ec",
      "backgroundLight": "#f6f6f8",
      "backgroundDark": "#101322"
    },

    "light": {
      "background": {
        "app": "#f6f6f8",
        "surface": "#ffffff",
        "surfaceAlt": "#f8fafc",
        "surfaceElevated": "#ffffff"
      },
      "text": {
        "primary": "#0f172a",
        "secondary": "#475569",
        "muted": "#64748b",
        "inverse": "#ffffff",
        "link": "#1337ec"
      },
      "border": {
        "subtle": "#f1f5f9",
        "default": "#e2e8f0",
        "strong": "#cbd5e1",
        "focus": "#1337ec"
      },
      "icon": {
        "default": "#64748b",
        "muted": "#94a3b8",
        "strong": "#475569"
      }
    },

    "dark": {
      "background": {
        "app": "#101322",
        "surface": "#101322",
        "surfaceAlt": "#0f172a",
        "surfaceCard": "#0b1220",
        "surfaceElevated": "#0f172a"
      },
      "text": {
        "primary": "#ffffff",
        "secondary": "#cbd5e1",
        "muted": "#94a3b8",
        "inverse": "#0f172a",
        "link": "#1337ec"
      },
      "border": {
        "subtle": "#1e293b",
        "default": "#1f2937",
        "strong": "#334155",
        "focus": "#1337ec"
      },
      "icon": {
        "default": "#94a3b8",
        "muted": "#64748b",
        "strong": "#cbd5e1"
      }
    },

    "semantic": {
      "overlayScrim": "rgba(2, 6, 23, 0.55)",
      "focusRing": "rgba(19, 55, 236, 0.5)"
    },

    "status": {
      "active": {
        "light": {
          "bg": "#dcfce7",
          "text": "#15803d",
          "border": "#bbf7d0",
          "dot": "#22c55e"
        },
        "dark": {
          "bg": "rgba(34,197,94,0.18)",
          "text": "#4ade80",
          "border": "rgba(34,197,94,0.25)",
          "dot": "#22c55e"
        }
      },
      "inactive": {
        "light": {
          "bg": "#fef3c7",
          "text": "#92400e",
          "border": "#fde68a",
          "dot": "#f59e0b"
        },
        "dark": {
          "bg": "rgba(245,158,11,0.18)",
          "text": "#fbbf24",
          "border": "rgba(245,158,11,0.25)",
          "dot": "#f59e0b"
        }
      },
      "completed": {
        "light": {
          "bg": "#dbeafe",
          "text": "#1d4ed8",
          "border": "#bfdbfe",
          "dot": "#1337ec"
        },
        "dark": {
          "bg": "rgba(19,55,236,0.18)",
          "text": "#93c5fd",
          "border": "rgba(19,55,236,0.25)",
          "dot": "#1337ec"
        }
      },
      "cancelled": {
        "light": {
          "bg": "#fee2e2",
          "text": "#b91c1c",
          "border": "#fecaca",
          "dot": "#ef4444"
        },
        "dark": {
          "bg": "rgba(239,68,68,0.18)",
          "text": "#fca5a5",
          "border": "rgba(239,68,68,0.25)",
          "dot": "#ef4444"
        }
      },
      "pending": {
        "light": {
          "bg": "#fef3c7",
          "text": "#92400e",
          "border": "#fde68a",
          "dot": "#f59e0b"
        },
        "dark": {
          "bg": "rgba(245,158,11,0.18)",
          "text": "#fbbf24",
          "border": "rgba(245,158,11,0.25)",
          "dot": "#f59e0b"
        }
      }
    }
  },

  "typography": {
    "roles": {
      "display": { "fontFamily": "display" },
      "body": { "fontFamily": "body" }
    },
    "weights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "pageTitle": {
        "fontFamily": "display",
        "sizePx": 30,
        "weight": 700,
        "lineHeight": 1.15,
        "letterSpacing": "-0.02em"
      },
      "h2": {
        "fontFamily": "display",
        "sizePx": 20,
        "weight": 700,
        "lineHeight": 1.25,
        "letterSpacing": "-0.01em"
      },
      "h3": {
        "fontFamily": "display",
        "sizePx": 18,
        "weight": 700,
        "lineHeight": 1.3
      },
      "body": {
        "fontFamily": "body",
        "sizePx": 14,
        "weight": 400,
        "lineHeight": 1.5
      },
      "bodyMedium": {
        "fontFamily": "body",
        "sizePx": 14,
        "weight": 500,
        "lineHeight": 1.5
      },
      "bodyStrong": {
        "fontFamily": "body",
        "sizePx": 14,
        "weight": 700,
        "lineHeight": 1.5
      },
      "small": {
        "fontFamily": "body",
        "sizePx": 12,
        "weight": 500,
        "lineHeight": 1.35
      },
      "xsUpper": {
        "fontFamily": "body",
        "sizePx": 11,
        "weight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "0.08em",
        "transform": "uppercase"
      }
    }
  },

  "radii": {
    "default": 4,
    "lg": 8,
    "xl": 12,
    "full": 9999
  },

  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32,
    "pagePadding": 24,
    "containerMaxWidthPx": 1280
  },

  "shadows": {
    "none": "none",
    "sm": "0 1px 2px rgba(15, 23, 42, 0.06)",
    "md": "0 6px 18px rgba(15, 23, 42, 0.10)"
  },

  "borders": {
    "width": { "hairline": 1, "thick": 2 },
    "style": "solid"
  },

  "motion": {
    "durationMs": { "fast": 150, "normal": 200, "slow": 300 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" }
  },

  "components": {
    "sidebar": {
      "widthPx": 256,
      "bg": { "light": "#ffffff", "dark": "#101322" },
      "borderColor": { "light": "#e2e8f0", "dark": "#1f2937" },
      "item": {
        "heightPx": 44,
        "radius": "lg",
        "paddingX": 12,
        "gapPx": 12,
        "text": { "light": "#475569", "dark": "#94a3b8" },
        "icon": { "light": "#64748b", "dark": "#64748b" },
        "hoverBg": { "light": "#f8fafc", "dark": "#1e293b" },
        "activeBg": {
          "light": "rgba(19,55,236,0.10)",
          "dark": "rgba(19,55,236,0.20)"
        },
        "activeText": { "light": "#1337ec", "dark": "#1337ec" },
        "activeIcon": { "light": "#1337ec", "dark": "#1337ec" }
      },
      "sectionLabel": {
        "typography": "xsUpper",
        "color": { "light": "#94a3b8", "dark": "#64748b" }
      }
    },

    "topbar": {
      "heightPx": 64,
      "bg": { "light": "#ffffff", "dark": "#101322" },
      "borderColor": { "light": "#e2e8f0", "dark": "#1f2937" },
      "breadcrumb": {
        "muted": { "light": "#64748b", "dark": "#94a3b8" },
        "active": { "light": "#0f172a", "dark": "#ffffff" },
        "separatorIcon": "chevron_right"
      }
    },

    "button": {
      "radius": "lg",
      "heightPx": 40,
      "paddingX": 20,
      "typography": "bodyMedium",
      "variants": {
        "primary": {
          "bg": "#1337ec",
          "text": "#ffffff",
          "hoverBg": "#0f2fcc",
          "shadow": "0 1px 2px rgba(19, 55, 236, 0.30)"
        },
        "secondary": {
          "bg": { "light": "#ffffff", "dark": "#1e293b" },
          "text": { "light": "#334155", "dark": "#cbd5e1" },
          "border": { "light": "#cbd5e1", "dark": "#334155" },
          "hoverBg": { "light": "#f8fafc", "dark": "#334155" }
        },
        "ghost": {
          "bg": "transparent",
          "text": { "light": "#475569", "dark": "#94a3b8" },
          "hoverBg": { "light": "#f1f5f9", "dark": "#1e293b" }
        }
      }
    },

    "input": {
      "radius": "lg",
      "heightPx": 40,
      "paddingX": 16,
      "typography": "body",
      "bg": { "light": "#f1f5f9", "dark": "#1f2937" },
      "text": { "light": "#0f172a", "dark": "#ffffff" },
      "placeholder": { "light": "#94a3b8", "dark": "#64748b" },
      "border": "transparent",
      "focusRing": "rgba(19,55,236,0.50)"
    },

    "select": {
      "radius": "lg",
      "heightPx": 44,
      "paddingX": 16,
      "bg": { "light": "#f6f6f8", "dark": "#101322" },
      "border": { "light": "#e2e8f0", "dark": "#334155" },
      "focusRing": "rgba(19,55,236,0.20)"
    },

    "card": {
      "radius": "xl",
      "bg": { "light": "#ffffff", "dark": "#0f172a" },
      "border": { "light": "#e2e8f0", "dark": "#1f2937" },
      "shadow": "sm",
      "hoverShadow": "md",
      "paddingPx": 20
    },

    "cardFooter": {
      "bg": {
        "light": "rgba(248,250,252,0.50)",
        "dark": "rgba(30,41,59,0.50)"
      },
      "borderTop": { "light": "#f1f5f9", "dark": "#1f2937" },
      "paddingX": 20,
      "paddingY": 16
    },

    "pillBadge": {
      "radius": "full",
      "heightPx": 24,
      "paddingX": 10,
      "typography": "small",
      "dotSizePx": 6,
      "borderWidthPx": 1
    },

    "iconTile": {
      "radius": "lg",
      "paddingPx": 10,
      "bg": { "light": "rgba(19,55,236,0.10)", "dark": "rgba(19,55,236,0.20)" },
      "text": { "light": "#1337ec", "dark": "#1337ec" }
    },

    "filtersBar": {
      "radius": "xl",
      "bg": { "light": "#ffffff", "dark": "#0f172a" },
      "border": { "light": "#e2e8f0", "dark": "#1f2937" },
      "shadow": "sm",
      "paddingPx": 16,
      "gapPx": 12
    },

    "pagination": {
      "buttonRadius": "lg",
      "buttonHeightPx": 40,
      "buttonBorder": { "light": "#e2e8f0", "dark": "#334155" },
      "buttonText": { "light": "#475569", "dark": "#94a3b8" },
      "buttonHoverBg": { "light": "#f8fafc", "dark": "#1e293b" }
    }
  },

  "scrollbar": {
    "sizePx": 8,
    "thumb": { "light": "#cbd5e1", "hover": "#94a3b8" },
    "radiusPx": 4,
    "track": "transparent"
  }
}
